<CsoundSynthesizer>
<CsOptions>
</CsOptions>
<CsInstruments>
sr = 44100
ksmps = 64
nchnls = 2
0dbfs = 1

; a saw through a resonant lowpass, played as a short pattern
instr 1
  ifreq = p4
  iamp = p5
  icut = p6
  kenv expseg 1, p3, 0.01
  asaw vco2 iamp, ifreq
  kcut expseg icut, p3, icut * 0.2
  afilt moogladder asaw, kcut, 0.6
  aL, aR pan2 afilt * kenv, 0.5
  outs aL, aR
endin

</CsInstruments>
